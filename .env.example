# teach_agent 环境变量示例。复制为 .env 后按需修改：
#   cp .env.example .env
# M1（入库 + 检索）只依赖本地 embedding 模型，不需要任何 API key。

# ---- 答疑 LLM（M2；OpenAI 兼容协议）----
# 当前实测契约：DeepSeek 官方端点，模型名 deepseek-flash（v4 flash）。
# 换模型只改这三项，代码无需改动。
TEACH_LLM_BASE_URL=https://api.deepseek.com/v1
TEACH_LLM_API_KEY=sk-xxxx
TEACH_LLM_MODEL=deepseek-flash
TEACH_LLM_TEMPERATURE=0.3

# ---- Tavily 网络检索（仅用户明确要求书外拓展时才用）----
TAVILY_API_KEY=tvly-xxxx

# ---- Embedding（本地，完全离线）----
# 默认使用已在 HuggingFace 缓存中的 Qwen3-Embedding-0.6B；
# 若以后更换 BGE-M3，改为 BAAI/bge-m3 即可（embeddings.py 的 pooling 需另行适配）。
TEACH_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# auto / cuda / cpu
TEACH_EMBED_DEVICE=auto
TEACH_EMBED_BATCH_SIZE=8
TEACH_EMBED_MAX_LENGTH=8192
# Qwen3-Embedding 官方建议 query 侧使用英文任务指令（约提升 1%~5% 检索效果）
TEACH_EMBED_QUERY_INSTRUCTION=Given a student's question about a textbook, retrieve the textbook passages that answer the question

# ---- 切块参数 ----
TEACH_CHUNK_SIZE=700
TEACH_CHUNK_OVERLAP=80

# ---- 检索参数 ----
TEACH_TOP_K=6
# Chroma cosine distance 阈值（distance = 1 - 余弦相似度）
TEACH_SCORE_THRESHOLD=0.42

# ---- 数据目录（默认项目内 data/）----
# TEACH_DATA_DIR=/绝对路径/teach_agent/data

# ---- LangSmith Tracing（Agent 链路可观测；LangChain/LangGraph 自动上报）----
# key 在 https://smith.langchain.com/settings 创建（lsv2_pt_ 开头）
# 不追踪时把 LANGSMITH_TRACING 改为 false 即可
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_xxxx
# trace 归档项目名；不设则进 default
LANGSMITH_PROJECT=teach-agent
